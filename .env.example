# Copy this file to .env and fill in real values. Never commit .env.
#
# JWT signing secret: at least 64 random characters (HS512 requires >= 64 bytes). Required.
JWT_SECRET=
# Key that encrypts digital-certificate keystore passwords at rest: Base64-encoded 32 random bytes (AES-256). Required.
CERT_SECRET_KEY=
# Local database password used by the application. Required.
DB_PASS=
# Password for the compose Postgres container; must match DB_PASS.
POSTGRES_PASSWORD=
# Trust X-Forwarded-For / X-Real-IP for auth rate limiting. Set true ONLY behind a trusted proxy that overwrites them.
RATE_LIMIT_TRUST_FORWARDED=false
# Maximum number of per-IP rate-limit buckets kept in memory (least recently used are evicted first).
RATE_LIMIT_MAX_BUCKETS=10000

# Siigo Proveedor Tecnológico (D2). Leave DIAN_PROVIDER=mock until sandbox credentials exist.
DIAN_PROVIDER=mock
SIIGO_USERNAME=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=
SIIGO_SELLER_ID=
SIIGO_DOCUMENT_TYPE_ID=1
SIIGO_STAMP_SEND=true
SIIGO_MAIL_SEND=false
# IDs from Siigo /v1/taxes (not DIAN codes).
SIIGO_TAX_ID_IVA_0=
SIIGO_TAX_ID_IVA_5=
SIIGO_TAX_ID_IVA_19=
# IDs from Siigo /v1/payment-types?document_type=FV (not DIAN codes).
SIIGO_PAYMENT_TYPE_CASH=
SIIGO_PAYMENT_TYPE_CARD=
SIIGO_PAYMENT_TYPE_TRANSFER=
SIIGO_PAYMENT_TYPE_CHECK=

# The Factory HKA — proveedor DIAN de pruebas (SOAP 1.1).
# Activá el adaptador con DIAN_PROVIDER=thefactory.
FACTORY_API_URL=https://demoemision21.thefactoryhka.com.co/ws/v1.0/Service.svc
# tokenEmpresa del sandbox HKA. Nunca commitear el valor real.
FACTORY_API_TOKEN=
# tokenPassword del sandbox HKA. Nunca commitear el valor real.
FACTORY_API_PASSWORD=
FACTORY_TEST_ENV=true
# Rango de numeración registrado en HKA, por ejemplo FV-1. Requerido para enviar.
FACTORY_NUMBERING_RANGE=
# Códigos DIAN que HKA consume directamente (no son IDs propios del proveedor).
FACTORY_DOCUMENT_TYPE=01
FACTORY_OPERATION_TYPE=05
FACTORY_CURRENCY=COP
FACTORY_TAX_CODE_IVA=01
FACTORY_TAX_CODE_INC=04
FACTORY_UNIT_MEASURE=UN
# 1 = contado, 2 = crédito.
FACTORY_PAYMENT_METHOD=1
# Consumidor final cuando la venta no tiene tercero identificado.
FACTORY_FINAL_CONSUMER_IDENTIFICATION=222222222222
FACTORY_FINAL_CONSUMER_IDENTIFICATION_TYPE=13
FACTORY_FINAL_CONSUMER_NAME=Consumidor final
